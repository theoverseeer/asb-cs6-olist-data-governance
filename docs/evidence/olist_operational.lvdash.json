{
  "datasets": [
    {
      "name": "a3755962",
      "displayName": "op_kpis",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(DISTINCT order_id) AS orders,\r\n",
        "  SUM(price) AS sales_brl,\r\n",
        "  ROUND((SUM(price) + SUM(freight_value)) / SUM(order_weight), 2) AS aov_brl,\r\n",
        "  ROUND(SUM(CASE WHEN has_delivery THEN delivery_days * order_weight END)\r\n",
        "    / SUM(CASE WHEN has_delivery THEN order_weight END), 2) AS avg_delivery_days,\r\n",
        "  ROUND(100 * SUM(CASE WHEN has_delivery AND is_late THEN order_weight END)\r\n",
        "    / SUM(CASE WHEN has_delivery THEN order_weight END), 2) AS late_delivery_pct,\r\n",
        "  ROUND(SUM(CASE WHEN has_review THEN review_score * order_weight END)\r\n",
        "    / SUM(CASE WHEN has_review THEN order_weight END), 2) AS avg_review_score\r\n",
        "FROM olist_gov.semantic.sales_order_items\r\n",
        "WHERE is_valid_order;"
      ]
    },
    {
      "name": "aff2a027",
      "displayName": "op_monthly",
      "queryLines": [
        "SELECT purchase_month AS month, COUNT(DISTINCT order_id) AS orders, SUM(price) AS sales_brl\r\n",
        "FROM olist_gov.semantic.sales_order_items\r\n",
        "WHERE is_valid_order\r\n",
        "  AND purchase_month BETWEEN DATE'2017-01-01' AND DATE'2018-08-01'\r\n",
        "GROUP BY 1 ORDER BY 1;"
      ]
    },
    {
      "name": "06c3cb28",
      "displayName": "op_category",
      "queryLines": [
        "SELECT product_category AS category, SUM(price) AS sales_brl\r\n",
        "FROM olist_gov.semantic.sales_order_items\r\n",
        "WHERE is_valid_order\r\n",
        "GROUP BY 1 ORDER BY 2 DESC LIMIT 10;"
      ]
    },
    {
      "name": "6892e771",
      "displayName": "op_late_monthly",
      "queryLines": [
        "SELECT purchase_month AS month,\r\n",
        "       100 * SUM(CASE WHEN is_late THEN order_weight END) / SUM(order_weight) AS late_delivery_pct\r\n",
        "FROM olist_gov.semantic.sales_order_items\r\n",
        "WHERE is_valid_order AND has_delivery\r\n",
        "  AND purchase_month BETWEEN DATE'2017-01-01' AND DATE'2018-08-01'\r\n",
        "GROUP BY 1 ORDER BY 1;"
      ]
    },
    {
      "name": "b59e49af",
      "displayName": "op_state_delivery",
      "queryLines": [
        "SELECT customer_state,\r\n",
        "       SUM(delivery_days * order_weight) / SUM(order_weight) AS avg_delivery_days\r\n",
        "FROM olist_gov.semantic.sales_order_items\r\n",
        "WHERE is_valid_order AND has_delivery\r\n",
        "GROUP BY 1 ORDER BY 2 DESC;"
      ]
    },
    {
      "name": "0a45817b",
      "displayName": "op_review_dist",
      "queryLines": [
        "SELECT review_score, ROUND(SUM(order_weight)) AS orders\r\n",
        "FROM olist_gov.semantic.sales_order_items\r\n",
        "WHERE is_valid_order AND has_review\r\n",
        "GROUP BY 1 ORDER BY 1;"
      ]
    }
  ],
